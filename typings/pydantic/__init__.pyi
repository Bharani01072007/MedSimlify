from typing import Any, Callable, ClassVar, Optional, Type

class BaseModel:
    def __init__(self, **data: Any) -> None: ...
    def dict(self, *args: Any, **kwargs: Any) -> dict: ...
    def json(self, *args: Any, **kwargs: Any) -> str: ...
    def model_dump(self, *args: Any, **kwargs: Any) -> dict: ...
    # Declared as ClassVar so subclass inner `class Config:` overrides are valid
    Config: ClassVar[Any]

def Field(default: Any = ..., *args: Any, **kwargs: Any) -> Any: ...
def validator(*args: Any, **kwargs: Any) -> Any: ...
def root_validator(*args: Any, **kwargs: Any) -> Any: ...

class BaseSettings(BaseModel): ...

# EmailStr — present in pydantic[email] extra; defined here as str subclass so
# code that imports it always gets a valid type even without the email extra installed.
EmailStr = str
